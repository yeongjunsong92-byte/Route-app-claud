# Firebase 프로젝트 설정 (Firebase Console > 프로젝트 설정 > 일반 에서 확인)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps Platform (Google Cloud Console > API 및 서비스 > 사용 설정된 API)
# 아래 API를 반드시 활성화하세요: Maps JavaScript API, Places API, Directions API
# 브라우저 키는 HTTP 리퍼러 제한을 걸어 사용하는 것을 권장합니다.
VITE_GOOGLE_MAPS_API_KEY=
