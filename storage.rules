// storage.rules
// Route 앱 Firebase Storage 보안 규칙
// src/lib/storage.ts의 업로드 경로(course-covers/{userId}/..., post-images/{userId}/{postId}/...,
// avatars/{userId})와 1:1로 대응합니다.
//
// 배포: firebase deploy --only storage
// (Firebase CLI 미설치 시: Firebase Console > Storage > 규칙 탭에 이 내용을 붙여넣기)

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 코스 커버 이미지: 코스 카드/상세에서 누구나 볼 수 있어야 하므로 공개 읽기,
    // 업로드는 본인 uid 경로에만 가능.
    match /course-covers/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // 피드 게시물 사진: 피드가 공개이므로 공개 읽기, 업로드는 본인 uid 경로에만 가능.
    match /post-images/{userId}/{postId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // 프로필 아바타: 프로필처럼 공개 읽기, 업로드는 본인 uid 경로에만 가능.
    match /avatars/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // 여행 기록 사진: 여행 기록은 개인 기록이므로, 본인만 읽고 쓸 수 있습니다.
    match /travel-log-photos/{userId}/{courseId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // 위에서 명시하지 않은 나머지 모든 경로는 기본 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
